{
  "name": "@gahmp1/ds-native",
  "version": "0.0.0",
  "description": "Componentes React Native do devaocubo-ds: provedor, estilos por tema, movimento, primitivos e composição.",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./motion": { "types": "./dist/motion.d.ts", "default": "./dist/motion.js" },
    "./ai": { "types": "./dist/ai.d.ts", "default": "./dist/ai.js" }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "assets/sounds"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "node ../../scripts/sounds.mjs && tsc -b"
  },
  "dependencies": {
    "@gahmp1/ds-core": "*",
    "@gahmp1/ds-theme": "*"
  },
  "peerDependencies": {
    "@shopify/flash-list": ">=2.3",
    "@shopify/react-native-skia": ">=2.14",
    "expo-audio": ">=58",
    "expo-blur": ">=58",
    "expo-haptics": ">=58",
    "react": ">=19.3",
    "react-native": ">=0.88",
    "react-native-gesture-handler": ">=3.3",
    "react-native-reanimated": ">=4.7",
    "react-native-safe-area-context": ">=5.10",
    "react-native-svg": ">=15.16",
    "react-native-worklets": ">=0.13"
  },
  "devDependencies": {
    "@shopify/flash-list": "2.3.2",
    "@shopify/react-native-skia": "2.14.0",
    "@types/react": "~19.3.0",
    "expo-audio": "~58.0.10",
    "expo-blur": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  }
